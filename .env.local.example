# Database Configuration
MONGODB_URI=mongodb://localhost:27017/amazon_clone

# Auth Secrets
JWT_SECRET=super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production

# Redis Cache (Optional - in-memory fallback will be used if omitted)
REDIS_URL=redis://localhost:6379

# Product API Key (Optional - Rainforest API key or Amazon PA-API key. If omitted, rich seed mock data is used automatically)
RAINFOREST_API_KEY=

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Delivery Configuration (Optional - for sending real emails via SMTP. E.g. Gmail App Password, Brevo, SendGrid, Amazon SES)
# If omitted, verification OTPs are displayed in the dev test banner and server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Amazon Clone <no-reply@amazon-clone.local>"
