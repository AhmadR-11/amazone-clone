# Database Configuration
MONGODB_URI=mongodb://localhost:27017/amazon_clone

# Auth Secrets
JWT_SECRET=super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production

# Redis Cache (Optional - in-memory fallback will be used if omitted)
REDIS_URL=redis://localhost:6379

# Product API Key (Optional - Rainforest API key or Amazon PA-API key. If omitted, rich seed mock data is used automatically)
RAINFOREST_API_KEY=

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
